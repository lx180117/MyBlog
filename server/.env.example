# =============================================================================
#  环境变量样例 —— 复制为 .env 后按实际环境填写
#  .env 已被 .gitignore 排除，切勿把真实密钥提交到版本库
# =============================================================================

# ---------------------------------------------------------------------------
#  对外地址（Docker 部署时**只需要改这一处**）
#
#  docker-compose.yml 会用它推导出 SITE_BASE_URL / UPLOAD_BASE_URL / CORS_ORIGINS，
#  以及前端的 NUXT_PUBLIC_SITE_URL。没设置的话 compose 会直接报错退出 ——
#  这是故意的：漏设的后果是 sitemap、canonical、图片链接全部指向 localhost，
#  而站点表面上还能正常打开，很难发现。
#
#  本地开发不跑 Docker 时这一项用不到，留着即可。
#    http 举例：http://1.2.3.4        （只有 IP、还没域名）
#    https 举例：https://blog.example.com
#  末尾不要带斜杠。
# ---------------------------------------------------------------------------
SITE_URL="http://localhost:3001"

# 数据库（本地开发用；Docker 部署时 compose 会用服务名覆盖它）
DATABASE_URL="postgresql://blog:blog_password@localhost:5432/blog?schema=public&connection_limit=10"

# JWT —— 生产环境必须替换，可用 `openssl rand -hex 32` 生成
# 两个密钥必须不同：Access 泄露不等于 Refresh 泄露，反之亦然
JWT_ACCESS_SECRET="please-change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="please-change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 服务
PORT=3000
API_PREFIX="api/v1"
NODE_ENV=development

# 允许跨域的前端源，逗号分隔（Docker 部署时由 SITE_URL 推导，这里不用管）
CORS_ORIGINS="http://localhost:3001,http://localhost:5173"

# 上传
UPLOAD_DIR="./uploads"
UPLOAD_MAX_SIZE=5242880
# 上传文件的对外前缀。Docker 部署时由 SITE_URL 推导；写成后端地址而不是前端地址，
# 是因为图片是 Nginx 从 /uploads/ 直出的，与前端同源
UPLOAD_BASE_URL="http://localhost:3000/uploads"

# 站点根地址，用于 sitemap / RSS 生成绝对链接（Docker 部署时由 SITE_URL 推导）
SITE_BASE_URL="http://localhost:3001"

# 初始化管理员（仅 seed 脚本使用）
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NICKNAME="站长"

# 定时发布扫描间隔（秒）
SCHEDULE_PUBLISH_INTERVAL=60
