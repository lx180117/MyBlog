{
  "name": "blog-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多作者博客平台 · 前台 + 作者工作台 + 管理后台",
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3001",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "gen:api": "node scripts/gen-api-types.mjs",
    "check:api": "node scripts/check-api-paths.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run check:api",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "dompurify": "^3.4.15",
    "element-plus": "^2.14.5",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "nuxt": "^4.5.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
